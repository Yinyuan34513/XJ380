mainmenu "XJ380 Configuration"

config XJ380
	bool
	default y

menu "Kernel"

choice BUILD_EDITION
	prompt "Build edition"
	default BUILD_EDITION_DEBUG
	help
	  Select the kernel build edition exported through build_settings.h.

config BUILD_EDITION_DEBUG
	bool "Debug"

config BUILD_EDITION_RELEASE
	bool "Release"

endchoice

config OS_VERSION
	string "OS version string"
	default "BetaVersion"

config KN_VERSION
	string "Kernel version string"
	default "XSK 2.1.0"

config OS_EDITION
	string "OS edition string"
	default "XINGJI XJ380 Singularity 1.0.0"

config STACK_SIZE
	int "Default kernel stack size"
	default 262144
	range 4096 16777216
	help
	  Default stack size in bytes.

config KERNEL_TASK_STACK_SIZE
	int "Per-thread kernel stack size"
	default 1048576
	range 16384 67108864

config USER_STACK_SIZE
	int "Default user stack size"
	default 16777216
	range 65536 268435456

config MAX_CPU_NUM
	int "Maximum CPU count tracked by the kernel"
	default 256
	range 1 1024
	help
	  Controls the static per-CPU storage limit in XSK SMP structures.

menu "Kernel Memory Layout"

config KERNEL_HEAP_START
	hex "Kernel heap virtual base"
	default 0xffffc00000000000

config KERNEL_HEAP_SIZE
	int "Kernel heap size in MiB"
	default 256
	range 16 4096

config USER_MMAP_START
	hex "User mmap base"
	default 0x0000400000000000

config USER_BRK_START
	hex "User brk start"
	default 0x0000700000000000

config USER_BRK_END
	hex "User brk end"
	default 0x00007ffff0000000

config USER_ELF_HEADER_START
	hex "User ELF header mapping base"
	default 0x0000300000000000

endmenu

menu "Kernel Boot Flow"

config KERNEL_BOOT_LOGO
	bool "Draw graphical boot logo"
	default y

config KERNEL_START_DESKTOP
	bool "Start desktop kernel threads"
	default y

config KERNEL_START_COMPONENT_FLUSHER
	bool "Start component flusher thread"
	depends on KERNEL_START_DESKTOP
	default y

config KERNEL_AUTO_START_USER_APP
	bool "Auto-start a user application after desktop init"
	depends on KERNEL_START_DESKTOP
	default y

config KERNEL_DEFAULT_USER_APP
	string "Default user application path"
	depends on KERNEL_AUTO_START_USER_APP
	default "/apps/browser.elf"

config KERNEL_LOAD_MODULES
	bool "Load kernel modules during boot"
	default y

config KERNEL_ENABLE_PROCESS_KILLER
	bool "Initialize process killer"
	default y

config KERNEL_AHCI_QEMU_ACCEL
	bool "Enable AHCI accelerated path under QEMU"
	default y

config KERNEL_DESKTOP_DEBUG_INPUT_ECHO
	bool "Echo typed debug characters on desktop"
	depends on BUILD_EDITION_DEBUG && KERNEL_START_DESKTOP
	default y

endmenu

endmenu

menu "QEMU"

config QEMU_MEMORY_MB
	int "QEMU memory size in MiB"
	default 8192
	range 128 1048576

config QEMU_DEBUG
	bool "Enable QEMU GDB stub and pause at startup"
	default y
	help
	  Enables the existing -s -S QEMU flags used for early debugging.

config QEMU_USE_SUDO
	bool "Run QEMU through sudo"
	default y

config QEMU_ENABLE_KVM
	bool "Enable KVM acceleration"
	default y

config QEMU_MACHINE
	string "QEMU machine type"
	default "q35"

config QEMU_BIOS
	string "QEMU BIOS/firmware image"
	default "OVMF.fd"

config QEMU_CPU_KVM
	string "QEMU CPU model when KVM is enabled"
	default "host"

config QEMU_CPU_TCG
	string "QEMU CPU model when KVM is disabled"
	default "max"

config QEMU_SMP_CPUS
	int "QEMU CPU count"
	default 4
	range 1 256

config QEMU_DISPLAY_BACKEND
	string "QEMU display backend"
	default "gtk"

config QEMU_AUDIO_BACKEND
	string "QEMU audio backend"
	default "sdl"

config QEMU_HDA_CODEC
	string "QEMU HDA codec device"
	default "hda-output"

config QEMU_SERIAL_LOG
	string "QEMU serial log path"
	default "serial.log"

config QEMU_ENABLE_USB_INPUT
	bool "Attach USB keyboard and mouse"
	default y

config QEMU_ENABLE_E1000
	bool "Attach e1000 network device"
	default y

config QEMU_HOSTFWD_TELNET
	bool "Forward host TCP 2323 to guest TCP 2323"
	depends on QEMU_ENABLE_E1000
	default y

endmenu

menu "Disk Image"

config IMAGE_SIZE_MB
	int "Raw disk image size in MiB"
	default 128
	range 64 32768

config IMAGE_EFI_PARTITION_START_SECTOR
	int "EFI partition start sector"
	default 2048
	range 2048 1048576

config IMAGE_FAT_SECTORS
	int "FAT filesystem size in sectors"
	default 0
	range 0 67108864
	help
	  Number of 512-byte sectors passed to mkfs.vfat. Use 0 to derive it
	  from the image size and EFI partition start sector.

config IMAGE_INCLUDE_TEST_DESKTOP_FILE
	bool "Copy test.txt to the default user's desktop"
	default y

config IMAGE_INCLUDE_STARDUST_EXAMPLES
	bool "Build and package StardustUI example applications"
	default y

config IMAGE_COPY_STARDUST_EXAMPLES
	bool "Copy StardustUI examples into /apps"
	depends on IMAGE_INCLUDE_STARDUST_EXAMPLES
	default y

choice VMDK_FORMAT
	prompt "VMDK output format"
	default VMDK_FORMAT_VMDK

config VMDK_FORMAT_VMDK
	bool "vmdk"

config VMDK_FORMAT_QCOW2
	bool "qcow2"

config VMDK_FORMAT_VHDX
	bool "vhdx"

endchoice

config VMDK_OUTPUT_FORMAT
	string
	default "vmdk" if VMDK_FORMAT_VMDK
	default "qcow2" if VMDK_FORMAT_QCOW2
	default "vhdx" if VMDK_FORMAT_VHDX

endmenu
