CONFIG_XJ380=y

#
# Kernel
#
CONFIG_BUILD_EDITION_DEBUG=y
# CONFIG_BUILD_EDITION_RELEASE is not set
CONFIG_OS_VERSION="BetaVersion"
CONFIG_KN_VERSION="XSK 2.1.0"
CONFIG_OS_EDITION="XINGJI XJ380 Singularity 1.0.0"
CONFIG_STACK_SIZE=262144
# end of Kernel

#
# QEMU
#
CONFIG_QEMU_DEBUG=y
CONFIG_QEMU_USE_SUDO=y
CONFIG_QEMU_ENABLE_KVM=y
CONFIG_QEMU_SMP_CPUS=4
CONFIG_QEMU_DISPLAY_BACKEND="gtk"
CONFIG_QEMU_AUDIO_BACKEND="sdl"
CONFIG_QEMU_HDA_CODEC="hda-output"
# end of QEMU
