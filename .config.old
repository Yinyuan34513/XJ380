CONFIG_XJ380=y

#
# Kernel
#
CONFIG_BUILD_EDITION_DEBUG=y
# CONFIG_BUILD_EDITION_RELEASE is not set
CONFIG_OS_VERSION="BetaVersion"
CONFIG_KN_VERSION="SUPER NB XINGJI SYSTEM KERNEL v114.514"
CONFIG_OS_EDITION="XINGJI XJ380 Singularity 1.0.0"
CONFIG_STACK_SIZE=262144
CONFIG_KERNEL_TASK_STACK_SIZE=1048576
CONFIG_USER_STACK_SIZE=16777216
CONFIG_MAX_CPU_NUM=256

#
# Kernel Memory Layout
#
CONFIG_KERNEL_HEAP_START=0xffffc00000000000
CONFIG_KERNEL_HEAP_SIZE=256
CONFIG_USER_MMAP_START=0x0000400000000000
CONFIG_USER_BRK_START=0x0000700000000000
CONFIG_USER_BRK_END=0x00007ffff0000000
CONFIG_USER_ELF_HEADER_START=0x0000300000000000
# end of Kernel Memory Layout

#
# Kernel Boot Flow
#
CONFIG_KERNEL_BOOT_LOGO=y
CONFIG_KERNEL_START_DESKTOP=y
CONFIG_KERNEL_START_COMPONENT_FLUSHER=y
CONFIG_KERNEL_AUTO_START_USER_APP=y
CONFIG_KERNEL_DEFAULT_USER_APP="/apps/browser.elf"
CONFIG_KERNEL_LOAD_MODULES=y
CONFIG_KERNEL_ENABLE_PROCESS_KILLER=y
CONFIG_KERNEL_AHCI_QEMU_ACCEL=y
CONFIG_KERNEL_DESKTOP_DEBUG_INPUT_ECHO=y
# end of Kernel Boot Flow
# end of Kernel

#
# QEMU
#
CONFIG_QEMU_MEMORY_MB=8192
CONFIG_QEMU_DEBUG=y
CONFIG_QEMU_USE_SUDO=y
CONFIG_QEMU_ENABLE_KVM=y
CONFIG_QEMU_MACHINE="q35"
CONFIG_QEMU_BIOS="OVMF.fd"
CONFIG_QEMU_CPU_KVM="host"
CONFIG_QEMU_CPU_TCG="max"
CONFIG_QEMU_SMP_CPUS=4
CONFIG_QEMU_DISPLAY_BACKEND="gtk"
CONFIG_QEMU_AUDIO_BACKEND="sdl"
CONFIG_QEMU_HDA_CODEC="hda-output"
CONFIG_QEMU_SERIAL_LOG="serial.log"
CONFIG_QEMU_ENABLE_USB_INPUT=y
CONFIG_QEMU_ENABLE_E1000=y
CONFIG_QEMU_HOSTFWD_TELNET=y
# end of QEMU

#
# Disk Image
#
CONFIG_IMAGE_SIZE_MB=128
CONFIG_IMAGE_EFI_PARTITION_START_SECTOR=2048
CONFIG_IMAGE_FAT_SECTORS=0
CONFIG_IMAGE_INCLUDE_TEST_DESKTOP_FILE=y
CONFIG_IMAGE_INCLUDE_STARDUST_EXAMPLES=y
CONFIG_IMAGE_COPY_STARDUST_EXAMPLES=y
CONFIG_VMDK_FORMAT_VMDK=y
# CONFIG_VMDK_FORMAT_QCOW2 is not set
# CONFIG_VMDK_FORMAT_VHDX is not set
CONFIG_VMDK_OUTPUT_FORMAT="vmdk"
# end of Disk Image
