# Generated by tools/gen_ninja.py. Run `ninja reconfigure` after changing the build graph.
ninja_required_version = 1.10
cc = clang
cxx = clang++
nasm = nasm
ld = ld
objc = objcopy
host_cc = cc
user_cc = clang
user_cxx = g++
user_ld = ld
nasm_flags = -f elf64 -DX86_64_TARGET -DUEFI
asm_flags = -O0 -g -mno-red-zone -mstackrealign -nostdlib -ffreestanding -fno-builtin -m64 -fno-stack-protector -fno-exceptions -mno-80387 -MMD -MP
c_flags = -O0 -g -mno-red-zone -mstackrealign -nostdlib -ffreestanding -fno-builtin -m64 -fno-stack-protector -fno-exceptions -std=c11 -fshort-wchar -nostdinc -mno-80387 -I./include -MMD -MP
cpp_flags = -O0 -g -mno-red-zone -mstackrealign -nostdlib -ffreestanding -fno-builtin -m64 -fno-stack-protector -fno-exceptions -fno-rtti -std=gnu++17 -fshort-wchar -nostdinc -fno-use-cxa-atexit -fno-threadsafe-statics -mno-80387 -Wno-int-to-pointer-cast -Wno-macro-redefined -Wno-c11-extensions -Wno-c99-extensions -Wno-gnu-statement-expression-from-macro-expansion -I./include -Wno-writable-strings -Wno-c++11-narrowing -MMD -MP -DXHCI_BUILTIN
boot_c_flags = -g -I ./boot/include -Wextra -e efi_main -nostdinc -nostdlib -fno-builtin -Wl,--subsystem,10 -fshort-wchar
user_cflags = -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c++11 -fno-stack-protector -fno-exceptions -fshort-wchar -nostdinc -I ./user/xapi/include -I ./user/include -I ./include -Wno-write-strings -MMD -MP
mbedtls_cflags = -I ./user/include/mbed_compat -I ./third_party/mbedtls-src/include -DMBEDTLS_USER_CONFIG_FILE='"mbed_compat/xj380_mbedtls_user_config.h"'
mbedtls_ccflags = -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c11 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/include/mbed_compat -I ./user/xapi/include -I ./user/include -I ./include -I ./third_party/mbedtls-src/include -DMBEDTLS_USER_CONFIG_FILE='"mbed_compat/xj380_mbedtls_user_config.h"' -DMBEDTLS_NO_UDBL_DIVISION -MMD -MP
browser_hosted_cxxflags = -O0 -Wall -g -std=c++17 -m64 -mstackrealign -fno-stack-protector -fno-threadsafe-statics -fno-use-cxa-atexit -ffunction-sections -fdata-sections -I ./user/browser -I ./third_party/litehtml/include -I ./third_party/litehtml/include/litehtml -I ./third_party/litehtml/src -I ./third_party/litehtml/src/gumbo -I ./third_party/litehtml/src/gumbo/include -I ./third_party/litehtml/src/gumbo/include/gumbo -I ./user/browser/third_party/libwebp -DLITEHTML_NO_THREADS -DLITEHTML_KEEP_GUMBO_OUTPUT -MMD -MP
browser_hosted_cflags = -O0 -Wall -g -std=c11 -m64 -mstackrealign -fno-stack-protector -ffunction-sections -fdata-sections -I ./third_party/litehtml/include -I ./third_party/litehtml/include/litehtml -I ./third_party/litehtml/src -I ./third_party/litehtml/src/gumbo -I ./third_party/litehtml/src/gumbo/include -I ./third_party/litehtml/src/gumbo/include/gumbo -I ./user/browser/third_party/libwebp -DNDEBUG -DHAVE_CONFIG_H -MMD -MP
libvterm_cflags = -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c99 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/xapi/include -I ./user/include -I ./third_party/libvterm/include -I ./third_party/libvterm/src -MMD -MP
kmod_cxxflags = -O0 -g -mno-red-zone -mstackrealign -nostdlib -ffreestanding -fno-builtin -m64 -fno-stack-protector -fno-exceptions -fno-rtti -std=gnu++17 -fshort-wchar -nostdinc -fno-use-cxa-atexit -fno-threadsafe-statics -mno-80387 -Wno-int-to-pointer-cast -Wno-macro-redefined -Wno-c11-extensions -Wno-c99-extensions -Wno-gnu-statement-expression-from-macro-expansion -Wno-writable-strings -Wno-c++11-narrowing -fPIC -fvisibility=hidden -MMD -MP
netserver_cflags = -O0 -g -mno-red-zone -mstackrealign -nostdlib -ffreestanding -fno-builtin -m64 -fno-stack-protector -fno-exceptions -std=gnu11 -fshort-wchar -nostdinc -mno-80387 -fPIC -fvisibility=hidden -MMD -MP -I./include -I./kmod/netserver/lwip/include -I./kmod/netserver
netserver_cxxflags = $kmod_cxxflags -MMD -MP -I./include -I./kmod/netserver/lwip/include -I./kmod/netserver
browser_stdcpp = /usr/lib/gcc/x86_64-linux-gnu/13/libstdc++.a
browser_supcpp = /usr/lib/gcc/x86_64-linux-gnu/13/libsupc++.a
browser_libgcc = /usr/lib/gcc/x86_64-linux-gnu/13/libgcc.a
browser_libgcc_eh = /usr/lib/gcc/x86_64-linux-gnu/13/libgcc_eh.a
host_gcc_triple = x86_64-linux-gnu

rule regen
  command = python3 tools/gen_ninja.py --out build.ninja
  description = [1;35m[GEN][0m build.ninja

rule nasm
  command = mkdir -p $$(dirname $out) && $nasm $nasm_flags $in -o $out && printf "[ASM] %s -> %s\n" $in $out
  description = [1;35m[ASM][0m $in -> $out

rule root_as
  command = mkdir -p $$(dirname $out) && $cc -mcmodel=large $asm_flags -MF $out.d -c $in -o $out && printf "[ASM] %s -> %s\n" $in $out
  description = [1;35m[ASM][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule root_cc
  command = mkdir -p $$(dirname $out) && $cc -fno-pic -fno-pie -mcmodel=large $c_flags -MF $out.d -c $in -o $out && printf "[CC] %s -> %s\n" $in $out
  description = [1;32m[CC][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule root_cxx
  command = mkdir -p $$(dirname $out) && $cxx -fno-pic -fno-pie -mcmodel=large $cpp_flags -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule gen_config
  command = tmp=$out.tmp; { echo '#pragma once'; echo '#define CONFIG_KERNEL_BUSYBOX_ALIASES '$${KERNEL_BUSYBOX_ALIASES:-1}; echo '#define CONFIG_KERNEL_BUILTIN_XHCI '$${BUILTIN_XHCI:-1}; } > $$tmp; if ! cmp -s $$tmp $out; then mv $$tmp $out; else rm -f $$tmp; fi
  description = [1;35m[GEN][0m $out

rule boot
  command = mkdir -p $$(dirname $out) && x86_64-w64-mingw32-gcc $boot_c_flags -o $out boot/bootx64.c boot/bootlib.c
  description = [1;35m[BOOT][0m $out

rule objcopy_bin
  command = mkdir -p $$(dirname $out) && $objc -I binary -O elf64-x86-64 $bin_input $out
  description = [1;35m[OBJCOPY][0m $bin_input

rule kernel_link
  command = $ld -z muldefs -T linker.ld --static -o $out $in
  description = [1;33m[LD][0m $out

rule download_liballoc
  command = [ -f $out ] && echo FOUND $out || curl -Lo $out https://github.com/plos-clan/liballoc/releases/download/release/liballoc-x86_64.a
  description = [1;34m[FETCH][0m $out

rule copy
  command = mkdir -p $$(dirname $out) && cp -a $in $out
  description = [1;34m[CP][0m $in -> $out

rule user_cxx_custom
  command = mkdir -p $$(dirname $out) && $user_cxx $cflags -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule user_cc_custom
  command = mkdir -p $$(dirname $out) && $user_cc $cflags -MF $out.d -c $in -o $out && printf "[CC] %s -> %s\n" $in $out
  description = [1;32m[CC][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule xapi_cxx
  command = mkdir -p $$(dirname $out) && $user_cxx -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c++11 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/xapi/include -Wno-write-strings -MMD -MP -MF $out.d -c $in -o $out && printf "[CXX] %s\n" $in
  description = [1;36m[CXX][0m $in
  depfile = $out.d
  deps = gcc

rule xapi_as
  command = mkdir -p $$(dirname $out) && $user_cc -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c++11 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/xapi/include -Wno-write-strings -MMD -MP -MF $out.d -c $in -o $out && printf "[ASM] %s\n" $in
  description = [1;35m[ASM][0m $in
  depfile = $out.d
  deps = gcc

rule xapi_head
  command = mkdir -p $$(dirname $out) && $user_cc -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c++11 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/xapi/include -Wno-write-strings -MMD -MP -MF $out.d -c $in -o $out && printf "[CXX] start.cpp\n"
  description = [1;36m[CXX][0m start.cpp
  depfile = $out.d
  deps = gcc

rule xapi_headcon
  command = mkdir -p $$(dirname $out) && $user_cc -O0 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -std=c++11 -fno-stack-protector -fshort-wchar -nostdinc -I ./user/xapi/include -Wno-write-strings -MMD -MP -MF $out.d -c $in -o $out && printf "[CXX] constart.cpp\n"
  description = [1;36m[CXX][0m constart.cpp
  depfile = $out.d
  deps = gcc

rule user_ld
  command = $user_ld -Ttext=0x200000 $in -o $out && echo "$message"
  description = [1;33m[LD][0m $out

rule host_cc
  command = mkdir -p $$(dirname $out) && $user_cc -O0 -g -Wall -Wextra $in -o $out && printf "[HOSTLD] %s -> %s\n" $in $out
  description = [1;33m[HOSTLD][0m $in

rule mbedtls_cc
  command = mkdir -p $$(dirname $out) && $user_cc $mbedtls_ccflags -MF $out.d -c $in -o $out && printf "[CC] %s -> %s\n" $in $out
  description = [1;32m[CC][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule browser_builtins
  command = mkdir -p $$(dirname $out) && python3 tools/ninja_build.py browser-builtins > $out
  description = [1;34m[FIND][0m browser builtins

rule link_with_builtins
  command = $user_ld $ldflags $in $$(cat out/browser-builtins.path) -o $out && echo "$message"
  description = [1;33m[LD][0m $out

rule browser_hosted_cxx
  command = mkdir -p $$(dirname $out) && $user_cxx $browser_hosted_cxxflags -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule litehtml_cxx
  command = mkdir -p $$(dirname $out) && $user_cxx $browser_hosted_cxxflags -fno-exceptions -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule litehtml_encodings_cxx
  command = mkdir -p $$(dirname $out) && $user_cxx $browser_hosted_cxxflags -fexceptions -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule browser_hosted_cc
  command = mkdir -p $$(dirname $out) && $user_cc $browser_hosted_cflags -MF $out.d -c $in -o $out && printf "[CC] %s -> %s\n" $in $out
  description = [1;32m[CC][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule link_browser
  command = $user_ld -Ttext=0x200000 --gc-sections --wrap=free $in --start-group $browser_stdcpp $browser_supcpp $browser_libgcc_eh $browser_libgcc $$(cat out/browser-builtins.path) --end-group -o $out && printf "[LD] %s\n" $out
  description = [1;33m[LD][0m $out

rule libvterm_cc
  command = mkdir -p $$(dirname $out) && $user_cc $libvterm_cflags -MF $out.d -c $in -o $out && printf "[CC] %s -> %s\n" $in $out
  description = [1;32m[CC][0m $in -> $out
  depfile = $out.d
  deps = gcc

rule kmod_e1000_cxx
  command = mkdir -p $$(dirname $out) && $cxx $kmod_cxxflags -I./include -MF $out.d -c $in -o $out
  description = [1;36m[CXX][0m $in
  depfile = $out.d
  deps = gcc

rule kmod_xhci_cxx
  command = mkdir -p $$(dirname $out) && $cxx $kmod_cxxflags -I./include -I./kmod/xhci -MF $out.d -c $in -o $out
  description = [1;36m[CXX][0m $in
  depfile = $out.d
  deps = gcc

rule netserver_cc
  command = mkdir -p $$(dirname $out) && $cc $netserver_cflags -MF $out.d -c $in -o $out
  description = [1;32m[CC][0m $in
  depfile = $out.d
  deps = gcc

rule netserver_cxx
  command = mkdir -p $$(dirname $out) && $cxx $netserver_cxxflags -MF $out.d -c $in -o $out
  description = [1;36m[CXX][0m $in
  depfile = $out.d
  deps = gcc

rule kmod_link
  command = $cxx -shared $in $ldflags -o $out
  description = [1;33m[LD][0m $out

rule stardust_cxx
  command = mkdir -p $$(dirname $out) && $user_cxx $cflags -MF $out.d -c $in -o $out && printf "[CXX] %s -> %s\n" $in $out
  description = [1;36m[CXX][0m $in
  depfile = $out.d
  deps = gcc

rule stardust_ld
  command = mkdir -p $$(dirname $out) && $user_ld -Ttext=0x200000 -e xapi_start $in -o $out && echo "$message"
  description = [1;33m[LD][0m $out

rule python_cmd
  command = python3 tools/ninja_build.py $cmd
  description = $desc

rule shell_cmd
  command = $cmd
  description = $desc

build build.ninja: regen tools/gen_ninja.py tools/ninja_build.py | Makefile user/Makefile user/xapi/Makefile

build kernel/build_config.h: gen_config

build liballoc-x86_64.a: download_liballoc

